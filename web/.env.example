# Vault addresses. While unset, the vault shows as opening and deposits are disabled.
NEXT_PUBLIC_VAULT_NVDA=
NEXT_PUBLIC_VAULT_SPCX=
# Every other eligible ticker: a JSON map of ticker to vault address, e.g. {"GOOGL":"0x...","CRCL":"0x..."}. Unlisted tickers show as opening.
NEXT_PUBLIC_VAULTS=
# Stats API (server-side rewrite target for /keeper/*)
KEEPER_URL=http://localhost:8790
