# Signer for rebalance() transactions. Place the key here yourself. Never commit .env.
VAULT_KEEPER_KEY=
# Optional: only used by --dry-run to impersonate the keeper in eth_call when no key is set.
VAULT_KEEPER_ADDRESS=
# VaultFactory: vaults it created are picked up from its VaultCreated logs. Deploy block bounds the log scan.
VAULT_FACTORY=
VAULT_FACTORY_DEPLOY_BLOCK=
# Or one vault address per eligible ticker (NVDA, SPCX, CRCL, GOOGL). Empty means "not deployed": the stats API serves
# replay figures for that ticker. An explicit address wins over the factory.
VAULT_ADDRESS_NVDA=
VAULT_ADDRESS_SPCX=
VAULT_ADDRESS_CRCL=
VAULT_ADDRESS_GOOGL=
# Deploy block of each vault (getLogs start). Required once the address is set.
VAULT_DEPLOY_BLOCK_NVDA=
VAULT_DEPLOY_BLOCK_SPCX=
VAULT_DEPLOY_BLOCK_CRCL=
VAULT_DEPLOY_BLOCK_GOOGL=
# Optional overrides (defaults in src/config.ts)
RPC_URL=
STATS_PORT=
MAX_DEV_BPS=
CL_MAX_AGE_S=
